#!/usr/bin/env bash
# Run the kadet-hub gate's static scan and sandbox compile on a generator.
#
# Usage: ./check <generator dir>
# Needs: Linux x86-64, docker, git, curl, uv, yq, python3. REGISTRY_REF
# selects the kadet-hub/registry commit whose gate scripts, scanner pins and
# sandbox image are used (default: main, what the gate runs). Without gVisor
# the syscall trace is not judged; exceptions (SEC-14) apply only in the gate.
set -euo pipefail
gen=$(cd -- "${1:?usage: ./check <generator dir>}" && pwd)
name=$(basename -- "$gen")
ref=${REGISTRY_REF:-main}
work=$(mktemp -d)
trap 'rm -rf -- "$work"' EXIT

git -c advice.detachedHead=false clone -q --depth 1 --branch "$ref" https://github.com/kadet-hub/registry.git "$work/registry" 2>/dev/null \
  || { git init -q "$work/registry" && git -C "$work/registry" fetch -q --depth 1 https://github.com/kadet-hub/registry.git "$ref" \
       && git -C "$work/registry" -c advice.detachedHead=false checkout -q FETCH_HEAD; }
reg=$work/registry
echo "registry $(git -C "$reg" rev-parse --short HEAD)"

echo "## sandbox image"
docker build -q -t kadet-hub/sandbox "$reg/sandbox" >/dev/null

echo "## static scan (SEC-1 to SEC-6, QA-3)"
# The scanners as the gate's setup-gate action pins them, installed under $work.
action=$reg/.github/actions/setup-gate/action.yml
gitleaks=$(sed -n 's/^ *GITLEAKS_VERSION: *//p' "$action")
curl -fsSLo "$work/gitleaks.tar.gz" "https://github.com/gitleaks/gitleaks/releases/download/${gitleaks}/gitleaks_${gitleaks#v}_linux_x64.tar.gz"
echo "$(sed -n 's/^ *GITLEAKS_SHA256: *//p' "$action")  $work/gitleaks.tar.gz" | sha256sum -c --quiet -
mkdir -- "$work/bin"
tar -xzf "$work/gitleaks.tar.gz" -C "$work/bin" gitleaks
python=$(sed -n 's/.*--python-version=\([0-9.]*\).*/\1/p' "$reg/scan/requirements.txt")
uv venv -q --python "$python" "$reg/scan/.venv"
uv pip install -q --python "$reg/scan/.venv/bin/python" --require-hashes --no-deps -r "$reg/scan/requirements.txt"
PATH=$work/bin:$PATH "$reg/scan/static-scan" "$gen"

echo "## compile, tags, schemas"
SANDBOX_TRACE=0 "$reg/sandbox/gate-compile" "$gen" "$name"
echo "check passed"
